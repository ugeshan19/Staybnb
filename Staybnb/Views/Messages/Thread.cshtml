@model ThreadViewModel
@{ ViewData["Title"] = "Conversation"; var me = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<div class="mx-auto" style="max-width: 820px">
    <a asp-action="Inbox" class="small">&larr; Inbox</a>
    <div class="panel mt-2">
        <div class="d-flex align-items-center gap-2 pb-3 border-bottom mb-3">
            <span class="avatar">@Model.OtherUser.Initials</span>
            <div><div class="fw-semibold">@Model.OtherUser.FullName</div><div class="small text-muted">@Model.OtherUser.Email</div></div>
        </div>
        <div style="min-height: 240px; max-height: 480px; overflow-y: auto">
            @foreach (var m in Model.Messages)
            {
                <div class="bubble-wrap @(m.SenderId == me ? "mine" : "")">
                    <div class="bubble">@m.Content<small>@m.Timestamp.ToString("dd MMM HH:mm")@(m.SenderId == me ? (m.IsRead ? " \u00b7 Read" : " \u00b7 Sent") : "")</small></div>
                </div>
            }
            @if (!Model.Messages.Any()) { <div class="text-center text-muted py-5">No messages yet - say hello!</div> }
        </div>
        <form asp-action="Send" method="post" class="d-flex gap-2 mt-3">
            <input type="hidden" name="receiverId" value="@Model.OtherUser.Id" />
            <textarea name="content" rows="2" maxlength="2000" class="form-control" placeholder="Write a reply..." required></textarea>
            <button class="btn btn-sb align-self-end"><i class="fa-solid fa-paper-plane"></i></button>
        </form>
    </div>
</div>
