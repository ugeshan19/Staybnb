@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var filter = ViewBag.Filter as string ?? "all";
    int all = ViewBag.AllCount; int unread = ViewBag.UnreadCount;
}
<div class="mx-auto" style="max-width: 820px">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex gap-2">
            <a class="type-pill @(filter == "all" ? "active" : "")" asp-action="Index">All (@all)</a>
            <a class="type-pill @(filter == "unread" ? "active" : "")" asp-action="Index" asp-route-filter="unread">Unread (@unread)</a>
            <a class="type-pill @(filter == "read" ? "active" : "")" asp-action="Index" asp-route-filter="read">Read (@(all - unread))</a>
        </div>
        @if (unread > 0)
        {
            <form asp-action="MarkAllRead" method="post"><button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-check-double"></i> Mark all read</button></form>
        }
    </div>
    @foreach (var n in Model)
    {
        var icon = n.Type switch
        {
            NotificationType.Success => "fa-circle-check text-success",
            NotificationType.Warning => "fa-triangle-exclamation text-warning",
            NotificationType.Booking => "fa-calendar-check text-primary",
            NotificationType.Message => "fa-envelope text-info",
            NotificationType.Application => "fa-file-lines text-primary",
            NotificationType.CheckIn => "fa-id-card text-primary",
            _ => "fa-circle-info text-secondary"
        };
        <div class="panel mb-2 d-flex gap-3 align-items-start @(n.IsRead ? "" : "border-danger-subtle bg-light")">
            <i class="fa-solid @icon fs-5 mt-1"></i>
            <div class="flex-fill">
                <div class="d-flex justify-content-between">
                    <span class="@(n.IsRead ? "fw-semibold" : "fw-bold")">@n.Title @if (!n.IsRead) { <span class="badge text-bg-danger ms-1">New</span> }</span>
                    <span class="small text-muted">@UiHelper.Ago(n.CreatedAt)</span>
                </div>
                <div class="small text-muted">@n.Message</div>
                <div class="d-flex gap-2 mt-2">
                    <a class="btn btn-sm btn-sb" asp-action="Open" asp-route-id="@n.Id">@(string.IsNullOrEmpty(n.Link) ? "Mark read" : "Take action")</a>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" asp-route-id="@n.Id" method="post"><button class="btn btn-sm btn-outline-secondary">Mark as read</button></form>
                    }
                    <form asp-action="Delete" asp-route-id="@n.Id" method="post"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any()) { <div class="panel text-center text-muted py-5">No notifications.</div> }
</div>
