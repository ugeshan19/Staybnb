@model List<Payment>
@{
    ViewData["Title"] = "Earnings";
    decimal Payout(Payment p) => p.Amount - (p.Booking?.ServiceFee ?? 0);
}
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="stat-card"><div class="stat-value">@UiHelper.Money(Model.Sum(p => Payout(p)))</div><div class="small text-muted">Total payouts (after service fee)</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="stat-value">@Model.Count</div><div class="small text-muted">Paid bookings</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="stat-value">@UiHelper.Money(Model.Sum(p => p.Booking?.ServiceFee ?? 0))</div><div class="small text-muted">Service fees retained by Staybnb</div></div></div>
</div>
<div class="panel">
    <h6>By property</h6>
    <table class="table table-sm">
        <thead><tr><th>Property</th><th>Bookings</th><th class="text-end">Payout</th></tr></thead>
        <tbody>
        @foreach (var g in Model.GroupBy(p => p.Booking?.Property?.Title ?? "-"))
        {
            <tr><td>@g.Key</td><td>@g.Count()</td><td class="text-end">@UiHelper.Money(g.Sum(p => Payout(p)))</td></tr>
        }
        </tbody>
    </table>
    <h6 class="mt-4">Payment history</h6>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Guest</th><th>Property</th><th class="text-end">Guest paid</th><th class="text-end">Payout</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr><td>@p.CreatedAt.ToString("dd MMM yyyy")</td><td>@p.Booking?.Guest?.FullName</td><td>@p.Booking?.Property?.Title</td><td class="text-end">@UiHelper.Money(p.Amount)</td><td class="text-end">@UiHelper.Money(Payout(p))</td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">No earnings yet.</td></tr> }
        </tbody>
    </table>
</div>
