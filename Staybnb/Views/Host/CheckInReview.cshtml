@model GuestCheckIn
@{
    ViewData["Title"] = "Verify Check-in";
    var active = Model.Documents.Where(d => d.Status != DocumentStatus.Rejected).ToList();
    var canConfirm = Model.Status == CheckInStatus.Submitted && active.Count > 0 && active.All(d => d.Status == DocumentStatus.Verified);
}
<a asp-action="CheckIns" class="small">&larr; All check-ins</a>
<div class="row g-4 mt-1">
    <div class="col-lg-4">
        <div class="panel">
            <h6>@Model.Booking?.Guest?.FullName</h6>
            <div class="small text-muted mb-2">@Model.Booking?.Guest?.Email</div>
            <div><strong>@Model.Booking?.Property?.Title</strong></div>
            <div class="small">@Model.Booking?.CheckInDate.ToString("dd MMM yyyy") &rarr; @Model.Booking?.CheckOutDate.ToString("dd MMM yyyy")</div>
            <div class="my-2">Check-in: <span class="@UiHelper.Badge(Model.Status.ToString())">@Model.Status</span></div>
            <div class="small">House rules: @(Model.RulesAcknowledged ? "accepted" : "not accepted")</div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="panel">
            <h6>Submitted documents</h6>
            @foreach (var d in Model.Documents.OrderBy(d => d.UploadedAt))
            {
                <div class="border rounded p-3 mb-2">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <i class="fa-solid fa-file"></i> <strong>@d.DocumentType</strong>
                            <a class="ms-2" asp-controller="Documents" asp-action="Download" asp-route-id="@d.Id" target="_blank">Open @d.OriginalName</a>
                            <div class="small text-muted">Uploaded @d.UploadedAt.ToString("dd MMM yyyy HH:mm")</div>
                            @if (!string.IsNullOrEmpty(d.RejectionReason)) { <div class="small text-danger">Reason: @d.RejectionReason</div> }
                        </div>
                        <span class="@UiHelper.Badge(d.Status.ToString())">@d.Status</span>
                    </div>
                    @if (d.Status == DocumentStatus.Pending && Model.Status == CheckInStatus.Submitted)
                    {
                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            <form asp-action="VerifyDocument" method="post"><input type="hidden" name="documentId" value="@d.Id" /><button class="btn btn-sm btn-success">Verify</button></form>
                            <form asp-action="RejectDocument" method="post" class="d-flex gap-2">
                                <input type="hidden" name="documentId" value="@d.Id" />
                                <input name="reason" class="form-control form-control-sm" placeholder="Reason (optional)" maxlength="300" />
                                <button class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        </div>
                    }
                </div>
            }
            @if (!Model.Documents.Any()) { <div class="text-muted">The guest hasn't uploaded anything yet.</div> }

            @if (Model.Status == CheckInStatus.Submitted)
            {
                <form asp-action="ConfirmCheckIn" asp-route-id="@Model.Id" method="post" class="mt-3">
                    <button class="btn btn-sb" disabled="@(!canConfirm)">Confirm guest check-in</button>
                    @if (!canConfirm) { <span class="small text-muted ms-2">Verify all documents first.</span> }
                </form>
            }
        </div>
    </div>
</div>
