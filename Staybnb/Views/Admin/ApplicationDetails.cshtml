@model HostApplication
@{
    ViewData["Title"] = "Application Review";
    var p = Model.Property!;
    var roles = ViewBag.ApplicantRoles as IList<string> ?? new List<string>();
}
<a asp-action="Applications" class="small">&larr; All applications</a>
<div class="row g-4 mt-1">
    <div class="col-lg-8">
        <div class="panel">
            <div class="d-flex justify-content-between"><h4>@p.Title</h4><span class="@UiHelper.Badge(Model.Status.ToString())">@Model.Status</span></div>
            <div class="text-muted">@p.Address, @p.City, @p.Country &middot; @p.PropertyType</div>
            <div class="d-flex flex-wrap gap-2 my-3">
                @foreach (var img in p.Images) { <a href="@img.ImageUrl" target="_blank"><img class="thumb" style="width:140px;height:100px" src="@UiHelper.Img(img.ImageUrl)" alt="" /></a> }
                @if (!p.Images.Any()) { <span class="text-danger">No images - incomplete application</span> }
            </div>
            <p style="white-space:pre-line">@p.Description</p>
            <div class="row small">
                <div class="col-6 col-md-3"><div class="text-muted">Price / night</div><strong>@UiHelper.Money(p.PricePerNight)</strong></div>
                <div class="col-6 col-md-3"><div class="text-muted">Cleaning fee</div><strong>@UiHelper.Money(p.CleaningFee)</strong></div>
                <div class="col-6 col-md-3"><div class="text-muted">Capacity</div><strong>@p.MaxGuests guests</strong></div>
                <div class="col-6 col-md-3"><div class="text-muted">Rooms</div><strong>@p.Bedrooms bd / @p.Beds beds / @p.Bathrooms ba</strong></div>
            </div>
            <div class="mt-3">@foreach (var a in p.Amenities) { <span class="badge text-bg-light border me-1"><i class="@a.IconClass"></i> @a.Name</span> }</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel mb-3">
            <h6>Applicant</h6>
            <div class="fw-semibold">@Model.ApplicationUser?.FullName</div>
            <div class="small text-muted">@Model.ApplicationUser?.Email</div>
            <div class="small mt-1">Current roles: @foreach (var r in roles) { <span class="badge-soft-secondary me-1">@r</span> }</div>
            <div class="small mt-1">Applied: @Model.AppliedAt.ToString("dd MMM yyyy HH:mm")</div>
            @if (Model.ReviewedAt != null) { <div class="small mt-1">Reviewed: @Model.ReviewedAt?.ToString("dd MMM yyyy HH:mm") by @Model.ReviewedBy?.FullName</div> }
            @if (!string.IsNullOrEmpty(Model.AdminNotes)) { <div class="small mt-1 text-danger">Note: @Model.AdminNotes</div> }
            <a class="btn btn-outline-secondary btn-sm mt-2" asp-controller="Messages" asp-action="Thread" asp-route-id="@Model.ApplicationUserId"><i class="fa-regular fa-envelope"></i> Message applicant</a>
        </div>
        @if (Model.Status == ApplicationStatus.Pending)
        {
            <div class="panel">
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="mb-3" onsubmit="return confirm('Approve this application? The applicant becomes a Host and loses the Guest role.');">
                    <button class="btn btn-success w-100"><i class="fa-solid fa-check"></i> Approve</button>
                    <div class="form-text">Adds the <strong>Host</strong> role and removes <strong>Guest</strong>.</div>
                </form>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                    <textarea name="notes" class="form-control mb-2" rows="2" maxlength="500" placeholder="Reason for rejection (shown to applicant)"></textarea>
                    <button class="btn btn-outline-danger w-100"><i class="fa-solid fa-xmark"></i> Reject</button>
                </form>
            </div>
        }
    </div>
</div>
