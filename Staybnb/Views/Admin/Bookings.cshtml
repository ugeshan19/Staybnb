@model List<Booking>
@{ ViewData["Title"] = "All Bookings"; }
<div class="panel">
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>#</th><th>Guest</th><th>Property</th><th>Dates</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr><td>@b.Id</td><td>@b.Guest?.FullName</td><td>@b.Property?.Title</td><td>@b.CheckInDate.ToString("dd MMM") - @b.CheckOutDate.ToString("dd MMM yyyy")</td><td>@UiHelper.Money(b.TotalPrice)</td><td><span class="@UiHelper.Badge((b.Payment?.Status ?? PaymentStatus.Pending).ToString())">@(b.Payment?.Status ?? PaymentStatus.Pending)</span></td><td><span class="@UiHelper.Badge(b.Status.ToString())">@b.Status</span></td></tr>
            }
            @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No bookings.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
