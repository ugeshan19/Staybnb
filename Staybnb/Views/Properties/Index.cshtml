@model PropertyIndexViewModel
@{ ViewData["Title"] = "Find your next stay"; }
<h2 class="mb-1">Relax. Unwind. Choose your next stay.</h2>
<p class="text-muted">Browse active listings from verified hosts.</p>

<form method="get" asp-action="Index" class="filter-bar row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label small mb-1">City</label>
        <input name="city" value="@Model.City" list="cityList" class="form-control" placeholder="Anywhere" />
        <datalist id="cityList">@foreach (var c in Model.Cities) { <option value="@c"></option> }</datalist>
    </div>
    <div class="col-md-4">
        <label class="form-label small mb-1">Property type</label>
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in Enum.GetValues<PropertyType>())
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-sb flex-fill" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="type-pill @(Model.Type == null ? "active" : "")" asp-action="Index" asp-route-city="@Model.City">All</a>
    @foreach (var t in Enum.GetValues<PropertyType>())
    {
        <a class="type-pill @(Model.Type == t ? "active" : "")" asp-action="Index" asp-route-city="@Model.City" asp-route-type="@t">@t</a>
    }
</div>

@if (!Model.Properties.Any())
{
    <div class="text-center text-muted py-5"><i class="fa-regular fa-face-frown fa-2x mb-2"></i><p>No stays match your search.</p></div>
}
else
{
    <div class="prop-grid">
        @foreach (var p in Model.Properties)
        {
            <partial name="_PropertyCard" model="p" view-data='new ViewDataDictionary(ViewData) { { "Wished", Model.WishlistIds.Contains(p.Id) }, { "IsGuest", User.IsInRole(Roles.Guest) } }' />
        }
    </div>
}
