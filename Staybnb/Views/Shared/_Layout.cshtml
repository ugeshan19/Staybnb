<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sb-header">
        <div class="container-xl d-flex align-items-center justify-content-between py-3">
            <a class="sb-brand" asp-controller="Home" asp-action="Index"><i class="fa-brands fa-airbnb"></i> staybnb</a>

            <a class="sb-search d-none d-md-flex" asp-controller="Properties" asp-action="Index">
                <span>Anywhere</span><span>Any week</span><span class="text-muted">Add guests</span>
                <span class="sb-search-btn"><i class="fa-solid fa-magnifying-glass"></i></span>
            </a>

            <nav class="d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="sb-link d-none d-lg-inline" asp-controller="HostApplication" asp-action="Status">Host Application Status</a>
                    <a class="sb-link d-none d-lg-inline" asp-controller="HostApplication" asp-action="Create">Become a Host</a>
                    @await Component.InvokeAsync("TopBar")
                    <div class="dropdown">
                        <button class="sb-menu-btn" data-bs-toggle="dropdown"><i class="fa-solid fa-bars"></i> <i class="fa-solid fa-circle-user fs-5"></i></button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><span class="dropdown-item-text small text-muted">@User.Identity?.Name</span></li>
                            <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index">My Trips</a></li>
                            <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                            <li><a class="dropdown-item" asp-controller="Messages" asp-action="Inbox">Messages</a></li>
                            <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                            <li><a class="dropdown-item d-lg-none" asp-controller="HostApplication" asp-action="Status">Host Application Status</a></li>
                            <li><a class="dropdown-item d-lg-none" asp-controller="HostApplication" asp-action="Create">Become a Host</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="sb-link" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-sb btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </nav>
        </div>
    </header>

    <main class="container-xl py-4">
        <partial name="_BackButton" />
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="sb-footer text-center py-4 mt-5">
        <small class="text-muted">&copy; @DateTime.Now.Year Staybnb &middot; Managed property rentals</small>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
