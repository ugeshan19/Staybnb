@model PropertyFormViewModel
@{ var requireImage = ViewData["RequireImage"] as bool? ?? false; }
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="PropertyType" class="form-label"></label><select asp-for="PropertyType" asp-items="Html.GetEnumSelectList<PropertyType>()" class="form-select"></select></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="PricePerNight" class="form-label"></label><input asp-for="PricePerNight" type="number" step="0.01" min="1" class="form-control" /><span asp-validation-for="PricePerNight" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="CleaningFee" class="form-label"></label><input asp-for="CleaningFee" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="CleaningFee" class="text-danger small"></span></div>
    <div class="col-md-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /><span asp-validation-for="Country" class="text-danger small"></span></div>
    <div class="col-6 col-md-3"><label asp-for="MaxGuests" class="form-label"></label><input asp-for="MaxGuests" type="number" min="1" class="form-control" /></div>
    <div class="col-6 col-md-3"><label asp-for="Bedrooms" class="form-label"></label><input asp-for="Bedrooms" type="number" min="0" class="form-control" /></div>
    <div class="col-6 col-md-3"><label asp-for="Beds" class="form-label"></label><input asp-for="Beds" type="number" min="1" class="form-control" /></div>
    <div class="col-6 col-md-3"><label asp-for="Bathrooms" class="form-label"></label><input asp-for="Bathrooms" type="number" min="1" class="form-control" /></div>
    <div class="col-12">
        <label class="form-label">Amenities</label>
        <div class="row">
            @foreach (var a in Model.AllAmenities)
            {
                <div class="col-6 col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedAmenityIds" value="@a.Id" id="am@(a.Id)" checked="@(Model.SelectedAmenityIds.Contains(a.Id))" />
                        <label class="form-check-label" for="am@(a.Id)"><i class="@a.IconClass"></i> @a.Name</label>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Images" class="form-label">@(requireImage ? "Photos (at least one required)" : "Add more photos")</label>
        <input asp-for="Images" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple data-preview="imgPreview" required="@requireImage" />
        <div class="form-text">JPG, PNG, WEBP or GIF, max 5 MB each.</div>
        <span asp-validation-for="Images" class="text-danger small"></span>
        <div id="imgPreview" class="mt-2"></div>
    </div>
</div>
