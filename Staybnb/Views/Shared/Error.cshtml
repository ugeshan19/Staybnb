@{ ViewData["Title"] = "Error"; }
<div class="text-center py-5">
    <h1 class="text-danger">Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request.</p>
    @if (ViewData["RequestId"] != null) { <p class="small">Request ID: <code>@ViewData["RequestId"]</code></p> }
    <a class="btn btn-sb" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
