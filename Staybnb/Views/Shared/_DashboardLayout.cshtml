@{
    var isHost = User.IsInRole(Roles.Host);
    var isSuper = User.IsInRole(Roles.SuperAdmin);
    var label = isHost ? "staybnb host" : "staybnb admin";
    var roleText = isHost ? "Host" : isSuper ? "SuperAdmin" : "Administrator";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @label</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="dash-body">
    <div class="dash-wrapper" id="dashWrapper">
        <aside class="dash-sidebar">
            <a class="sb-brand px-3 py-3 d-block" asp-controller="Home" asp-action="Index"><i class="fa-brands fa-airbnb"></i> <span class="menu-text">@label</span></a>
            <ul class="dash-nav">
                @if (isHost)
                {
                    <li><a asp-controller="Host" asp-action="Dashboard"><i class="fa-solid fa-chart-pie"></i><span class="menu-text">Dashboard</span></a></li>
                    <li><a asp-controller="Host" asp-action="Properties"><i class="fa-solid fa-house"></i><span class="menu-text">My Properties</span></a></li>
                    <li><a asp-controller="Host" asp-action="Bookings"><i class="fa-solid fa-calendar-check"></i><span class="menu-text">Booking Requests</span></a></li>
                    <li><a asp-controller="Host" asp-action="CheckIns"><i class="fa-solid fa-id-card"></i><span class="menu-text">Guest Check-ins</span></a></li>
                    <li><a asp-controller="Host" asp-action="Earnings"><i class="fa-solid fa-money-bill-wave"></i><span class="menu-text">Earnings</span></a></li>
                    <li><a asp-controller="Host" asp-action="Reviews"><i class="fa-solid fa-star"></i><span class="menu-text">Reviews</span></a></li>
                    <li><a asp-controller="HostApplication" asp-action="Status"><i class="fa-solid fa-file-signature"></i><span class="menu-text">Applications</span></a></li>
                }
                else
                {
                    <li><a asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-chart-pie"></i><span class="menu-text">Dashboard</span></a></li>
                    @if (isSuper)
                    {
                        <li><a asp-controller="Admin" asp-action="Users"><i class="fa-solid fa-users"></i><span class="menu-text">Users</span></a></li>
                    }
                    <li><a asp-controller="Admin" asp-action="Applications"><i class="fa-solid fa-file-lines"></i><span class="menu-text">Host Requests</span></a></li>
                    <li><a asp-controller="Admin" asp-action="Bookings"><i class="fa-solid fa-calendar-check"></i><span class="menu-text">Bookings</span></a></li>
                    <li><a asp-controller="Admin" asp-action="Properties"><i class="fa-solid fa-house"></i><span class="menu-text">Properties</span></a></li>
                    <li><a asp-controller="Admin" asp-action="ActivityLogs"><i class="fa-solid fa-clock-rotate-left"></i><span class="menu-text">Activity Logs</span></a></li>
                }
                <li><a asp-controller="Messages" asp-action="Inbox"><i class="fa-solid fa-envelope"></i><span class="menu-text">Messages</span></a></li>
                <li><a asp-controller="Notifications" asp-action="Index"><i class="fa-solid fa-bell"></i><span class="menu-text">Notifications</span></a></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dash-logout"><i class="fa-solid fa-right-from-bracket"></i><span class="menu-text">Logout</span></button>
                    </form>
                </li>
            </ul>
        </aside>

        <div class="dash-main">
            <header class="dash-topbar">
                <button class="btn btn-sm btn-light" id="sidebarToggle" type="button"><i class="fa-solid fa-bars"></i></button>
                <h1 class="dash-title">@ViewData["Title"]</h1>
                <div class="d-flex align-items-center gap-3">
                    @await Component.InvokeAsync("TopBar")
                    <span class="small text-end lh-sm d-none d-md-block">
                        <strong>@User.Identity?.Name</strong><br /><span class="text-muted">@roleText</span>
                    </span>
                </div>
            </header>
            <div class="dash-content">
                <partial name="_BackButton" />
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
