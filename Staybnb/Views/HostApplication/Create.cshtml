@model PropertyFormViewModel
@{ ViewData["Title"] = "Become a Host"; ViewData["RequireImage"] = true; }
<div class="mx-auto" style="max-width: 860px">
    <h2>Become a Host</h2>
    <p class="text-muted">Tell us about your property. An admin reviews every application - it can't be submitted without at least one photo.</p>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="panel">
        <partial name="_PropertyFormFields" model="Model" view-data="ViewData" />
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-sb" type="submit">Submit application</button>
            <a class="btn btn-outline-secondary" asp-action="Status">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
